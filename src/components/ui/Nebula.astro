---
// Soft pink + blue nebula clouds that slowly drift and morph.
// Pure CSS: blurred gradient blobs on long, offset animation loops.
---

<div class="nebula" aria-hidden="true">
  <span class="cloud cloud--blue-1"></span>
  <span class="cloud cloud--pink-1"></span>
  <span class="cloud cloud--blue-2"></span>
  <span class="cloud cloud--pink-2"></span>
</div>

<style>
  .nebula { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .cloud {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    mix-blend-mode: screen;
    will-change: transform;
  }
  /* LEFT side: big blue cloud + smaller pink one */
  .cloud--blue-1 {
    width: 40rem; height: 26rem; left: -14rem; top: 0;
    background: radial-gradient(closest-side, rgb(76 141 255 / 0.42), rgb(37 99 235 / 0.16) 55%, transparent);
    animation: neb-a 38s ease-in-out infinite alternate;
  }
  .cloud--pink-2 {
    width: 24rem; height: 16rem; left: 4%; top: 46%;
    background: radial-gradient(closest-side, rgb(217 40 117 / 0.36), rgb(217 40 117 / 0.1) 55%, transparent);
    animation: neb-d 46s ease-in-out infinite alternate;
  }
  /* RIGHT side: big pink cloud + smaller blue one */
  .cloud--pink-1 {
    width: 38rem; height: 24rem; right: -14rem; top: 8%;
    background: radial-gradient(closest-side, rgb(217 40 117 / 0.42), rgb(217 40 117 / 0.14) 55%, transparent);
    animation: neb-b 34s ease-in-out infinite alternate;
  }
  .cloud--blue-2 {
    width: 26rem; height: 18rem; right: 2%; top: 48%;
    background: radial-gradient(closest-side, rgb(34 140 255 / 0.32), rgb(76 141 255 / 0.1) 55%, transparent);
    animation: neb-c 42s ease-in-out infinite alternate;
  }

  /* motion stays mostly vertical + gentle in/out, so the clouds keep to the sides */
  @keyframes neb-a {
    0%   { transform: translate(0, 0) scale(1) rotate(0deg); }
    50%  { transform: translate(4rem, 3rem) scale(1.12, 0.92) rotate(8deg); }
    100% { transform: translate(1rem, 7rem) scale(0.95, 1.1) rotate(-6deg); }
  }
  .cloud--pink-1 { animation-name: neb-b; }
  @keyframes neb-b {
    0%   { transform: translate(0, 0) scale(1) rotate(0deg); }
    50%  { transform: translate(-4rem, 4rem) scale(1.15, 0.9) rotate(-8deg); }
    100% { transform: translate(-1rem, 8rem) scale(0.92, 1.12) rotate(6deg); }
  }
  @keyframes neb-c {
    0%   { transform: translate(0, 0) scale(1); }
    100% { transform: translate(-3rem, -6rem) scale(1.25, 0.9) rotate(-10deg); }
  }
  @keyframes neb-d {
    0%   { transform: translate(0, 0) scale(1); }
    100% { transform: translate(3rem, -5rem) scale(1.3, 1.05) rotate(10deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cloud { animation: none !important; }
  }
</style>
