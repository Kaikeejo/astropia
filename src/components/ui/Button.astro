---
interface Props {
  type?: 'primary' | 'secondary';
  size?: 'large' | 'small';
  href?: string;
  class?: string;
  [key: string]: unknown;
}
const { type = 'primary', size = 'large', href, class: cls, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag href={href} class:list={['btn', 'h6', `btn--${type}`, `btn--${size}`, type === 'secondary' && 'gradient-border', cls]} {...rest}>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    border-radius: var(--radius-full);
    white-space: nowrap;
    cursor: pointer;
    border: 0;
    transition: transform var(--dur) var(--ease), filter var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .btn--large { padding: var(--space-16) var(--space-24); }
  .btn--small { padding: var(--space-8) var(--space-16); }
  .btn--primary { background: var(--gradient-button); color: var(--color-text); }
  .btn--secondary { --gb-fill: var(--color-surface); border: 1px solid transparent; }
  .btn--large.btn--secondary { padding: calc(var(--space-16) - 1px) calc(var(--space-24) - 1px); }
  .btn--small.btn--secondary { padding: calc(var(--space-8) - 1px) calc(var(--space-16) - 1px); }

  .btn:hover { transform: translateY(-1px); }
  .btn--primary:hover { filter: brightness(1.12); box-shadow: 0 8px 24px -8px rgb(217 40 117 / 0.6); }
  .btn--secondary:hover { --gb-fill: var(--color-surface-2); }
  .btn:active { transform: translateY(0); }
  .btn:focus-visible { outline: 2px solid var(--color-blue); outline-offset: 2px; }
</style>
