---
interface Props { active?: boolean; value: string }
const { active = false, value } = Astro.props;
---

<button type="button" class="chip paragraph" data-filter={value} aria-pressed={active ? 'true' : 'false'}>
  <span class="chip__label"><slot /></span>
</button>

<style>
  .chip {
    position: relative;
    z-index: 1;
    padding: var(--space-8) var(--space-16);
    border: 0;
    border-radius: var(--radius-full);
    background: none;
    color: var(--color-text-muted);
    cursor: pointer;
    white-space: nowrap;
    transition: color var(--dur) var(--ease);
  }
  .chip:hover { color: var(--color-text); }
  .chip:focus-visible { outline: 2px solid var(--color-blue); outline-offset: 2px; }

  .chip[aria-pressed='true'] { color: var(--color-text); }
</style>
