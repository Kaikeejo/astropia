---
// Drifting pixel starfield in four depth layers.
// Square "pixel stars": 4px at the front, then 3px, 2px and 1px at the very back.
// Each layer is a fixed-size 1440x720 tile repeated across the area (pixels never scale up on wide screens)
// and scrolls sideways on a seamless loop; nearer layers move faster = parallax.
// The mouse also nudges the layers slightly (more for near layers).
const W = 1440, H = 720;
const inContent = (x: number, y: number) => x > 360 && x < 1080 && y > 72 && y < 384;

type Layer = { name: string; size: number; count: number; op: [number, number]; depth: number; speed: number; twinkleEvery: number };
const LAYERS: Layer[] = [
  { name: 'deep', size: 1, count: 170, op: [0.18, 0.45], depth: 4,  speed: 480, twinkleEvery: 11 },
  { name: 'far',  size: 2, count: 90,  op: [0.25, 0.55], depth: 8,  speed: 340, twinkleEvery: 9 },
  { name: 'mid',  size: 3, count: 40,  op: [0.35, 0.7],  depth: 16, speed: 210, twinkleEvery: 7 },
  { name: 'near', size: 4, count: 16,  op: [0.55, 0.95], depth: 28, speed: 130, twinkleEvery: 3 },
];

function tile(l: Layer, seed0: number) {
  let seed = seed0;
  const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
  let rects = '', added = 0, attempts = 0;
  while (added < l.count && attempts < 4000) {
    attempts++;
    const x = Math.floor(rnd() * (W - l.size)), y = Math.floor(rnd() * (H - l.size));
    if (inContent(x, y) && rnd() < 0.7) continue; // keep the headline area calmer
    const o = (l.op[0] + rnd() * (l.op[1] - l.op[0])).toFixed(2);
    const fill = rnd() < 0.25 ? '#cfe0ff' : '#ffffff';
    const tw = added % l.twinkleEvery === 0 ? ` class='t' style='animation-delay:${((added % 7) * 0.6).toFixed(1)}s'` : '';
    rects += `<rect x='${x}' y='${y}' width='${l.size}' height='${l.size}' fill='${fill}' opacity='${o}'${tw}/>`;
    added++;
  }
  // twinkle runs inside the tile image itself
  const style = `<style>.t{animation:t 4.2s ease-in-out infinite}@keyframes t{50%{opacity:.2}}@media (prefers-reduced-motion:reduce){.t{animation:none}}</style>`;
  const svg = `<svg xmlns='http://www.w3.org/2000/svg' width='${W}' height='${H}' viewBox='0 0 ${W} ${H}' shape-rendering='crispEdges'>${style}${rects}</svg>`;
  return `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
}
const layers = LAYERS.map((l, i) => ({ ...l, bg: tile(l, 42 + i * 7919) }));
---

<div class="starfield" aria-hidden="true" data-starfield>
  {layers.map((l) => (
    <div class={`starfield__layer starfield__layer--${l.name}`} style={`--depth:${l.depth}px; --speed:${l.speed}s`}>
      <div class="starfield__track" style={`background-image:${l.bg}`}></div>
    </div>
  ))}
</div>

<style>
  .starfield { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: hidden; filter: var(--starfield-filter); opacity: var(--starfield-opacity); }
  .starfield__layer {
    position: absolute; inset: -2rem;
    translate: calc(var(--mx, 0) * var(--depth)) calc(var(--my, 0) * var(--depth));
    transition: translate 1.2s var(--ease);
  }
  /* one tile wider than the layer, slid left by exactly one tile = seamless loop (GPU-friendly transform) */
  .starfield__track {
    position: absolute; top: 0; bottom: 0; left: 0;
    width: calc(100% + 1440px);
    background-size: 1440px 720px;   /* fixed: pixels never scale */
    background-repeat: repeat;
    animation: drift var(--speed) linear infinite;
  }
  @keyframes drift { to { transform: translateX(-1440px); } }

  @media (prefers-reduced-motion: reduce) {
    .starfield__track { animation: none; }
    .starfield__layer { transition: none; }
  }
</style>

<script>
  // gentle mouse parallax: layers shift a few px toward the pointer
  const fields = document.querySelectorAll<HTMLElement>('[data-starfield]');
  if (fields.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let raf = 0;
    addEventListener('pointermove', (e) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const mx = (e.clientX / innerWidth - 0.5) * -2;
        const my = (e.clientY / innerHeight - 0.5) * -2;
        fields.forEach((f) => { f.style.setProperty('--mx', String(mx)); f.style.setProperty('--my', String(my)); });
      });
    });
  }
</script>
