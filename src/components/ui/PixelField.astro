---
// Subtle, sparse pixel texture in the style of the Astropia logo mark.
// Same cell/step as the mark (4px squares on a 6px grid), white only, very low opacity.
// Mostly small pixel clusters (logo mark, pixel arrow and random organic blobs), only a few loose pixels.
// Generated once at build. Change `seed` for a different arrangement.
interface Props { seed?: number; class?: string }
const { seed: seed0 = 42, class: cls } = Astro.props;
const W = 1440, H = 480, STEP = 6, CELL = 4;
const COLS = Math.floor(W / STEP), ROWS = Math.floor(H / STEP);

let seed = seed0;
const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;

type Shape = (number | 'w')[][];
// the two pixel icons from the brand
const mark: Shape = [
  [0, 0.35, 1, 0],
  [0.6, 1, 'w', 0.5],
  [0, 0.8, 1, 0.25],
  [0.2, 0, 0.55, 0],
];
const arrow: Shape = [
  [0, 0.2, 0, 1, 0, 0],
  [0, 0, 0, 0.55, 1, 0],
  [0.25, 0.45, 0.7, 0.9, 'w', 1],
  [0, 0, 0, 0.55, 1, 0],
  [0, 0, 0.15, 1, 0, 0.3],
];
// random organic blob: dense in the middle, crumbling at the edges
function blob(w: number, h: number): Shape {
  const cx = (w - 1) / 2, cy = (h - 1) / 2;
  return Array.from({ length: h }, (_, r) => Array.from({ length: w }, (_, c) => {
    const d = Math.hypot((c - cx) / (cx + 0.5), (r - cy) / (cy + 0.5)); // 0 centre .. ~1 edge
    if (rnd() > 1.05 - d * 0.9) return 0;
    return d < 0.3 && rnd() < 0.5 ? 'w' : 0.25 + rnd() * 0.75;
  }));
}

const cells = new Map<string, number>();
const put = (c: number, r: number, o: number) => {
  if (c < 0 || r < 0 || c >= COLS || r >= ROWS) return;
  const k = `${c},${r}`;
  cells.set(k, Math.max(cells.get(k) ?? 0, o));
};
const stamp = (shape: Shape, c0: number, r0: number, base: number) => {
  const fx = rnd() < 0.5, fy = rnd() < 0.5, h = shape.length, w = shape[0].length;
  shape.forEach((row, r) => row.forEach((v, c) => {
    if (!v) return;
    put(c0 + (fx ? w - 1 - c : c), r0 + (fy ? h - 1 - r : r), base * (v === 'w' ? 1 : v));
  }));
};

// clusters of varied kinds and sizes, spread across the width in loose bands
const CLUSTERS = 18;
for (let i = 0; i < CLUSTERS; i++) {
  const kind = rnd();
  const shape = kind < 0.2 ? mark : kind < 0.35 ? arrow : blob(2 + Math.floor(rnd() * 6), 2 + Math.floor(rnd() * 5));
  const band = (i + rnd()) / CLUSTERS;                 // even-ish horizontal spread
  const c0 = Math.floor(band * (COLS - 8));
  const r0 = Math.floor(rnd() * (ROWS - 8));
  stamp(shape, c0, r0, 0.05 + rnd() * 0.09);           // each cluster its own strength
}
// a few loose pixels
for (let i = 0; i < 40; i++) put(Math.floor(rnd() * COLS), Math.floor(rnd() * ROWS), 0.03 + rnd() * 0.04);

const rects = [...cells].map(([k, o]) => { const [c, r] = k.split(',').map(Number); return { x: c * STEP, y: r * STEP, o }; });
---

<svg class:list={['pixel-field', cls]} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax slice" aria-hidden="true">
  {rects.map((p) => <rect x={p.x} y={p.y} width={CELL} height={CELL} rx="1" fill="#fff" opacity={p.o.toFixed(3)} />)}
</svg>

<style>
  .pixel-field {
    position: absolute; inset: 0; width: 100%; height: 100%;
    pointer-events: none;
    /* fade in from the top so the texture sits low in the footer */
    -webkit-mask: linear-gradient(to bottom, transparent, #000 60%);
    mask: linear-gradient(to bottom, transparent, #000 60%);
  }
</style>
