---
// Card thumbnails. STYLE switches between the new pixel thumbnails and the original
// line thumbnails (kept as a backup in PatternLines.astro + lib/patterns.ts).
import type { PatternName } from '../../lib/patterns';
import PatternLines from './PatternLines.astro';

const STYLE = 'pixels' as 'pixels' | 'lines'; // set to 'lines' to bring back the old thumbnails

interface Props {
  name: PatternName;
  /** add the thumbnail-sized vignette (used on smaller cards) */
  vignette?: boolean;
  /** show the empty thumbnail frame only, no artwork */
  blank?: boolean;
}
const { name, vignette = true, blank = false } = Astro.props;
---

{STYLE === 'lines' ? <PatternLines name={name} vignette={vignette} /> : (
  <div class="pattern" aria-hidden="true">
    <div class="pattern__canvas">
      <!-- static SVG masks built by src/pages/patterns/[name].svg.ts, painted with the spot colours -->
      {!blank && ['blue', 'pink', 'white'].map((tone) => (
        <span class={`pattern__tone pattern__tone--${tone}`} style={`--mask: url(/patterns/${name}-${tone}.svg)`}></span>
      ))}
    </div>
    {vignette && <div class="pattern__vignette"></div>}
  </div>
)}

<style>
  /* same frame, crop and vignette as the line thumbnails, so every card layout keeps working */
  .pattern {
    --pattern-bg: var(--pattern-bg-override, var(--pattern-bg-rgb));
    position: absolute;
    inset: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: inherit;
    background: rgb(var(--pattern-bg));
  }
  /* the 640x400 canvas is centered and cropped, never stretched (pixels stay 4px) */
  .pattern__canvas {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 640px;
    height: 400px;
    translate: -50% -50%;
    transition: scale 600ms var(--ease);
  }
  .pattern__tone {
    position: absolute; inset: 0;
    -webkit-mask: var(--mask) no-repeat 0 0 / 100% 100%;
    mask: var(--mask) no-repeat 0 0 / 100% 100%;
  }
  .pattern__tone--blue { background: var(--brand-blue); }
  .pattern__tone--pink { background: var(--brand-pink); }
  .pattern__tone--white { background: #fff; }
  .pattern__vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 60% 60% at 50% 50%,
      rgb(var(--pattern-bg) / 0) 0%,
      rgb(var(--pattern-bg) / 0.15) 35%,
      rgb(var(--pattern-bg) / 0.7) 70%,
      rgb(var(--pattern-bg) / 1) 100%
    );
  }
</style>
