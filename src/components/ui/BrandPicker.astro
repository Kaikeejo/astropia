---
// Two spot-colour pickers (blue + pink) in a grey pill. They set --brand-blue / --brand-pink on the
// page, so every blue and pink (buttons, borders, thumbnails, live heroes) follows. Saved in this browser.
import Icon from './Icon.astro';
---

<div class="brand-picker btn-raised" role="group" aria-label="Site colours">
  <label class="brand-picker__swatch" style="--swatch: var(--brand-blue)" title="Change the blue">
    <input type="color" data-brand="blue" aria-label="Blue spot colour" />
  </label>
  <label class="brand-picker__swatch" style="--swatch: var(--brand-pink)" title="Change the pink">
    <input type="color" data-brand="pink" aria-label="Pink spot colour" />
  </label>
  <button type="button" class="brand-picker__reset" data-brand-reset hidden aria-label="Reset colours" title="Reset colours"><Icon name="x" size={16} /></button>
</div>

<style>
  /* same 40px height as the theme toggle beside it */
  .brand-picker { display: flex; align-items: center; gap: 6px; height: 40px; padding: 0 8px; border-radius: var(--radius-full); }
  .brand-picker__swatch { position: relative; width: 24px; height: 24px; border-radius: 50%; background: var(--swatch); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.25); cursor: pointer; transition: scale var(--dur) var(--ease); }
  .brand-picker__swatch:hover { scale: 1.1; }
  .brand-picker__swatch:has(input:focus-visible) { outline: 2px solid var(--color-text); outline-offset: 2px; }
  .brand-picker__swatch input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; border: 0; padding: 0; }
  .brand-picker__reset { display: grid; place-items: center; width: 20px; height: 24px; padding: 0; border: 0; background: none; color: var(--color-text-muted); cursor: pointer; }
  .brand-picker__reset[hidden] { display: none; }
  .brand-picker__reset:hover { color: var(--color-text); }
</style>

<script>
  {
    const root = document.documentElement;
    const DEFAULT = { blue: '#4c8dff', pink: '#d92875' };
    const read = (): Record<string, string> => { try { return JSON.parse(localStorage.getItem('brand') || '{}'); } catch { return {}; } };
    const inputs = document.querySelectorAll<HTMLInputElement>('[data-brand]');
    const reset = document.querySelector<HTMLButtonElement>('[data-brand-reset]');
    const sync = () => {
      const saved = read();
      inputs.forEach((i) => { i.value = saved[i.dataset.brand!] ?? DEFAULT[i.dataset.brand as 'blue' | 'pink']; });
      if (reset) reset.hidden = !saved.blue && !saved.pink;
    };
    const apply = (saved: Record<string, string>) => {
      for (const k of ['blue', 'pink']) saved[k] ? root.style.setProperty(`--brand-${k}`, saved[k]) : root.style.removeProperty(`--brand-${k}`);
      try { localStorage.setItem('brand', JSON.stringify(saved)); } catch {}
      dispatchEvent(new Event('astropia:brand'));
    };
    inputs.forEach((input) => input.addEventListener('input', () => {
      apply({ ...read(), [input.dataset.brand!]: input.value });
      if (reset) reset.hidden = false;
    }));
    reset?.addEventListener('click', () => { apply({}); sync(); });
    sync();
  }
</script>
