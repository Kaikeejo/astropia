---
// Two spot-colour pickers (blue + pink) in the nav. They set --brand-blue / --brand-pink on the
// page, so every blue and pink (buttons, borders, thumbnails, live heroes) follows. Saved in this browser.
// Our own small picker (hex only): colour area + hue bar + hex field + presets, styled like the site.
const PRESETS = ['#4C8DFF', '#D92875', '#22D3EE', '#14B8A6', '#22C55E', '#A3E635', '#FACC15', '#F97316', '#EF4444', '#FB7185'];
---

<div class="brand-picker" data-brand-picker>
  <div class="brand-picker__pill" role="group" aria-label="Site colors">
    <button type="button" class="brand-picker__swatch" style="--swatch: var(--brand-blue)" data-brand-open="blue" aria-label="Change color 1" aria-haspopup="dialog" aria-expanded="false"></button>
    <button type="button" class="brand-picker__swatch" style="--swatch: var(--brand-pink)" data-brand-open="pink" aria-label="Change color 2" aria-haspopup="dialog" aria-expanded="false"></button>
  </div>

  <div class="cp" role="dialog" aria-label="Spot color" data-cp hidden>
    <div class="cp__tabs" role="tablist">
      <button type="button" role="tab" class="cp__tab" data-cp-tab="blue"><span style="--swatch: var(--brand-blue)"></span>Color 1</button>
      <button type="button" role="tab" class="cp__tab" data-cp-tab="pink"><span style="--swatch: var(--brand-pink)"></span>Color 2</button>
    </div>
    <div class="cp__area" data-cp-area role="slider" tabindex="0" aria-label="Saturation and brightness">
      <span class="cp__thumb" data-cp-area-thumb></span>
    </div>
    <div class="cp__hue" data-cp-hue role="slider" tabindex="0" aria-label="Hue" aria-valuemin="0" aria-valuemax="360">
      <span class="cp__thumb" data-cp-hue-thumb></span>
    </div>
    <label class="cp__hex">
      <span class="cp__preview" data-cp-preview></span>
      <span class="cp__hash" aria-hidden="true">#</span>
      <input type="text" maxlength="7" spellcheck="false" autocomplete="off" aria-label="Hex color" data-cp-hex />
    </label>
    <div class="cp__presets">
      {PRESETS.map((c) => <button type="button" class="cp__preset" style={`--swatch: ${c}`} data-cp-preset={c} aria-label={c} title={c}></button>)}
    </div>
    <button type="button" class="cp__reset paragraph" data-cp-reset>Reset to default</button>
  </div>
</div>

<style>
  .brand-picker { position: relative; }
  /* same look as the nav search bar, same 40px height as the theme toggle */
  .brand-picker__pill {
    display: flex; align-items: center; gap: 6px; height: 40px; padding: 0 7px;
    border-radius: var(--radius-full); border: 1px solid var(--color-border); background: var(--color-surface);
    transition: border-color var(--dur) var(--ease);
  }
  .brand-picker__pill:hover { border-color: var(--color-border-strong); }
  .brand-picker__swatch {
    width: 24px; height: 24px; padding: 0; border: 0; border-radius: 50%;
    background: var(--swatch); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.25);
    cursor: pointer; transition: scale var(--dur) var(--ease);
  }
  .brand-picker__swatch:hover, .brand-picker__swatch[aria-expanded='true'] { scale: 1.1; }
  .brand-picker__swatch[aria-expanded='true'] { outline: 2px solid var(--color-text); outline-offset: 2px; }
  .brand-picker__swatch:focus-visible { outline: 2px solid var(--color-text); outline-offset: 2px; }

  /* the picker panel */
  .cp {
    position: absolute; right: 0; top: calc(100% + var(--space-8)); z-index: 50;
    width: 248px; padding: 12px;
    display: flex; flex-direction: column; gap: 12px;
    border-radius: var(--radius-md); border: 1px solid var(--color-border); background: var(--color-surface);
    color: var(--color-text);
    animation: cp-in 180ms var(--ease);
  }
  .cp[hidden] { display: none; }
  @keyframes cp-in { from { opacity: 0; translate: 0 -4px; } }

  .cp__tabs { display: flex; gap: 2px; padding: 3px; border-radius: var(--radius-full); background: var(--color-well); border: 1px solid var(--color-border); }
  .cp__tab {
    flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    height: 28px; border: 0; border-radius: var(--radius-full); background: none;
    color: var(--color-text-muted); font: inherit; font-size: 0.75rem; cursor: pointer;
  }
  .cp__tab span { width: 10px; height: 10px; border-radius: 50%; background: var(--swatch); }
  .cp__tab[aria-selected='true'] { color: var(--color-text); background: var(--raised-bg); box-shadow: var(--raised-shadow); }

  /* saturation (left to right) + brightness (top to bottom) for the current hue */
  .cp__area {
    position: relative; height: 140px; border-radius: var(--radius-sm); cursor: crosshair; touch-action: none;
    background:
      linear-gradient(to top, #000, transparent),
      linear-gradient(to right, #fff, hsl(var(--hue, 0) 100% 50%));
  }
  .cp__hue {
    position: relative; height: 12px; border-radius: var(--radius-full); cursor: pointer; touch-action: none;
    background: linear-gradient(to right, #f00, #ff0, #0f0, #0ff, #00f, #f0f, #f00);
  }
  .cp__area:focus-visible, .cp__hue:focus-visible { outline: 2px solid var(--color-text); outline-offset: 2px; }
  .cp__thumb {
    position: absolute; width: 16px; height: 16px; translate: -50% -50%;
    border-radius: 50%; border: 2px solid #fff; background: var(--current);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.35), inset 0 0 0 1px rgb(0 0 0 / 0.2);
    pointer-events: none;
  }
  .cp__hue .cp__thumb { top: 50%; background: hsl(var(--hue, 0) 100% 50%); }

  .cp__hex {
    display: flex; align-items: center; gap: 6px; height: 36px; padding: 0 10px 0 6px;
    border-radius: var(--radius-full); border: 1px solid var(--color-border); background: var(--color-well);
  }
  .cp__hex:focus-within { border-color: var(--color-border-strong); }
  .cp__preview { width: 24px; height: 24px; border-radius: 50%; background: var(--current); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.25); flex: none; }
  .cp__hash { color: var(--color-text-muted); font-size: 0.875rem; }
  .cp__hex input {
    flex: 1; min-width: 0; border: 0; outline: 0; background: none; color: var(--color-text);
    font: inherit; font-size: 0.875rem; font-variant-numeric: tabular-nums; letter-spacing: 0.04em; text-transform: uppercase;
  }

  .cp__presets { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; justify-items: center; }
  .cp__preset {
    width: 28px; height: 28px; padding: 0; border: 0; border-radius: 50%;
    background: var(--swatch); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.2);
    cursor: pointer; transition: scale var(--dur) var(--ease);
  }
  .cp__preset:hover { scale: 1.12; }
  .cp__preset:focus-visible { outline: 2px solid var(--color-text); outline-offset: 2px; }
  .cp__preset[aria-pressed='true'] { outline: 2px solid var(--color-text); outline-offset: 2px; }

  .cp__reset {
    height: 32px; border: 0; border-radius: var(--radius-full); cursor: pointer;
    color: var(--color-text-muted); background: none; font-size: 0.75rem;
  }
  .cp__reset:hover { color: var(--color-text); background: var(--color-surface-2); }
  .cp__reset:disabled { opacity: 0.4; cursor: default; background: none; color: var(--color-text-muted); }
</style>

<script>
  const root = document.documentElement;
  const DEFAULT: Record<'blue' | 'pink', string> = { blue: '#4c8dff', pink: '#d92875' };
  type Key = 'blue' | 'pink';

  // ---- colour maths (hex <-> hue/saturation/value) ----
  const hexToHsv = (hex: string) => {
    const n = parseInt(hex.slice(1), 16), r = (n >> 16) / 255, g = ((n >> 8) & 255) / 255, b = (n & 255) / 255;
    const max = Math.max(r, g, b), d = max - Math.min(r, g, b);
    let h = 0;
    if (d) h = max === r ? ((g - b) / d) % 6 : max === g ? (b - r) / d + 2 : (r - g) / d + 4;
    return { h: (h * 60 + 360) % 360, s: max ? d / max : 0, v: max };
  };
  const hsvToHex = (h: number, s: number, v: number) => {
    const f = (n: number) => { const k = (n + h / 60) % 6; return v - v * s * Math.max(0, Math.min(k, 4 - k, 1)); };
    return '#' + [f(5), f(3), f(1)].map((x) => Math.round(x * 255).toString(16).padStart(2, '0')).join('');
  };
  const normalise = (raw: string) => {
    let t = raw.trim().replace(/^#/, '');
    if (/^[0-9a-f]{3}$/i.test(t)) t = t.split('').map((c) => c + c).join('');
    return /^[0-9a-f]{6}$/i.test(t) ? '#' + t.toLowerCase() : null;
  };

  // ---- saved colours ----
  const read = (): Partial<Record<Key, string>> => { try { return JSON.parse(localStorage.getItem('brand') || '{}'); } catch { return {}; } };
  const current = (k: Key) => read()[k] ?? DEFAULT[k];
  const save = (k: Key, hex: string | null) => {
    const saved = read();
    if (hex && hex !== DEFAULT[k]) saved[k] = hex; else delete saved[k];
    hex && hex !== DEFAULT[k] ? root.style.setProperty(`--brand-${k}`, hex) : root.style.removeProperty(`--brand-${k}`);
    try { localStorage.setItem('brand', JSON.stringify(saved)); } catch {}
    dispatchEvent(new Event('astropia:brand'));
  };

  document.querySelectorAll<HTMLElement>('[data-brand-picker]').forEach((picker) => {
    const panel = picker.querySelector<HTMLElement>('[data-cp]')!;
    const openers = picker.querySelectorAll<HTMLButtonElement>('[data-brand-open]');
    const tabs = picker.querySelectorAll<HTMLButtonElement>('[data-cp-tab]');
    const area = picker.querySelector<HTMLElement>('[data-cp-area]')!;
    const areaThumb = picker.querySelector<HTMLElement>('[data-cp-area-thumb]')!;
    const hue = picker.querySelector<HTMLElement>('[data-cp-hue]')!;
    const hueThumb = picker.querySelector<HTMLElement>('[data-cp-hue-thumb]')!;
    const hexInput = picker.querySelector<HTMLInputElement>('[data-cp-hex]')!;
    const presets = picker.querySelectorAll<HTMLButtonElement>('[data-cp-preset]');
    const reset = picker.querySelector<HTMLButtonElement>('[data-cp-reset]')!;

    let key: Key = 'blue';
    let hsv = hexToHsv(current(key));

    // draw the panel from the current colour
    const paint = (fromInput = false) => {
      const hex = hsvToHex(hsv.h, hsv.s, hsv.v);
      panel.style.setProperty('--hue', String(Math.round(hsv.h)));
      panel.style.setProperty('--current', hex);
      areaThumb.style.left = `${hsv.s * 100}%`;
      areaThumb.style.top = `${(1 - hsv.v) * 100}%`;
      hueThumb.style.left = `${(hsv.h / 360) * 100}%`;
      hue.setAttribute('aria-valuenow', String(Math.round(hsv.h)));
      area.setAttribute('aria-valuetext', `Saturation ${Math.round(hsv.s * 100)}%, brightness ${Math.round(hsv.v * 100)}%`);
      if (!fromInput) hexInput.value = hex.slice(1).toUpperCase();
      presets.forEach((p) => p.setAttribute('aria-pressed', String(p.dataset.cpPreset!.toLowerCase() === hex)));
      reset.disabled = hex === DEFAULT[key];
      return hex;
    };
    const commit = (fromInput = false) => save(key, paint(fromInput));
    const setHex = (hex: string, fromInput = false) => { const h = hsv.h; hsv = hexToHsv(hex); if (!hsv.s || !hsv.v) hsv.h = h; commit(fromInput); };

    const select = (k: Key) => {
      key = k;
      hsv = hexToHsv(current(k));
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.cpTab === k)));
      openers.forEach((o) => o.setAttribute('aria-expanded', String(!panel.hidden && o.dataset.brandOpen === k)));
      paint();
    };
    const open = (k: Key) => { panel.hidden = false; select(k); };
    const close = () => { panel.hidden = true; openers.forEach((o) => o.setAttribute('aria-expanded', 'false')); };

    openers.forEach((o) => o.addEventListener('click', () => {
      const k = o.dataset.brandOpen as Key;
      !panel.hidden && key === k ? close() : open(k);
    }));
    tabs.forEach((t) => t.addEventListener('click', () => select(t.dataset.cpTab as Key)));

    // dragging on the colour area and the hue bar
    const drag = (el: HTMLElement, onMove: (x: number, y: number) => void) => {
      const at = (e: PointerEvent) => {
        const r = el.getBoundingClientRect();
        onMove(Math.min(1, Math.max(0, (e.clientX - r.left) / r.width)), Math.min(1, Math.max(0, (e.clientY - r.top) / r.height)));
        commit();
      };
      el.addEventListener('pointerdown', (e) => { el.setPointerCapture(e.pointerId); at(e); });
      el.addEventListener('pointermove', (e) => { if (el.hasPointerCapture(e.pointerId)) at(e); });
    };
    drag(area, (x, y) => { hsv.s = x; hsv.v = 1 - y; });
    drag(hue, (x) => { hsv.h = x * 360; });

    // keyboard: arrows nudge (shift = bigger steps)
    area.addEventListener('keydown', (e) => {
      const d = e.shiftKey ? 0.1 : 0.01;
      const moves: Record<string, () => void> = {
        ArrowLeft: () => (hsv.s = Math.max(0, hsv.s - d)), ArrowRight: () => (hsv.s = Math.min(1, hsv.s + d)),
        ArrowUp: () => (hsv.v = Math.min(1, hsv.v + d)), ArrowDown: () => (hsv.v = Math.max(0, hsv.v - d)),
      };
      if (moves[e.key]) { e.preventDefault(); moves[e.key](); commit(); }
    });
    hue.addEventListener('keydown', (e) => {
      const d = e.shiftKey ? 10 : 1;
      if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') hsv.h = (hsv.h - d + 360) % 360;
      else if (e.key === 'ArrowRight' || e.key === 'ArrowUp') hsv.h = (hsv.h + d) % 360;
      else return;
      e.preventDefault(); commit();
    });

    // hex field: applies as soon as it's a valid colour (3 or 6 digits)
    hexInput.addEventListener('input', () => { const hex = normalise(hexInput.value); if (hex) setHex(hex, true); });
    hexInput.addEventListener('blur', () => paint());
    hexInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { paint(); hexInput.blur(); } });
    hexInput.addEventListener('paste', () => setTimeout(() => { const hex = normalise(hexInput.value); if (hex) { setHex(hex); } }));

    presets.forEach((p) => p.addEventListener('click', () => setHex(p.dataset.cpPreset!.toLowerCase())));
    reset.addEventListener('click', () => setHex(DEFAULT[key]));

    // close on outside click or Esc
    document.addEventListener('pointerdown', (e) => { if (!panel.hidden && !picker.contains(e.target as Node)) close(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) { close(); picker.querySelector<HTMLButtonElement>(`[data-brand-open="${key}"]`)?.focus(); }
    });
  });
</script>
