---
import Icon from './Icon.astro';
interface Props { title: string; subtitle?: string; link?: { label: string; href: string }; align?: 'left' | 'center' }
const { title, subtitle, link, align = 'left' } = Astro.props;
---

<div class:list={['section-header', `section-header--${align}`]}>
  <div class="section-header__text">
    <h2 class="h2">{title}</h2>
    {subtitle && <p class:list={[align === 'center' ? 'h5' : 'paragraph', 'muted']}>{subtitle}</p>}
  </div>
  {link && (
    <a class="arrow-link h6 blue" href={link.href}>{link.label}<Icon name="arrow-right" /></a>
  )}
</div>

<style>
  .section-header { display: flex; align-items: flex-end; gap: var(--space-24); }
  .section-header__text { flex: 1; display: flex; flex-direction: column; gap: var(--space-8); }
  .section-header--center { justify-content: center; text-align: center; }
  .section-header--center .section-header__text { gap: var(--space-16); align-items: center; }
  .arrow-link { display: inline-flex; align-items: center; gap: var(--space-8); }
  .arrow-link :global(svg) { transition: translate var(--dur) var(--ease); }
  .arrow-link:hover :global(svg) { translate: 4px 0; }
</style>
