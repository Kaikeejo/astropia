---
// Light / Dark / System switch. The choice is saved in localStorage ('theme');
// "System" follows the visitor's OS setting and updates live if it changes.
// The initial theme is applied by the inline script in Base.astro (before first paint).
import Icon from './Icon.astro';
const options = [
  { value: 'light', label: 'Light theme', icon: 'sun' },
  { value: 'dark', label: 'Dark theme', icon: 'moon' },
  { value: 'system', label: 'Use system theme', icon: 'monitor' },
] as const;
---

<div class="theme-toggle" role="group" aria-label="Color theme" data-theme-toggle>
  {options.map((o) => (
    <button type="button" class="theme-toggle__btn" data-theme-value={o.value} aria-label={o.label} title={o.label} aria-pressed="false">
      <Icon name={o.icon} size={16} />
    </button>
  ))}
</div>

<style>
  /* same dark pill + raised tab language as the filter bar */
  .theme-toggle {
    display: inline-flex; align-items: center; gap: 2px;
    padding: 3px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-well);
    box-shadow: var(--inset-shadow);
  }
  .theme-toggle__btn {
    display: grid; place-items: center;
    width: 32px; height: 32px;
    border: 0; border-radius: var(--radius-full);
    background: none; color: var(--color-text-muted);
    cursor: pointer;
    transition: color var(--dur) var(--ease);
  }
  .theme-toggle__btn:hover { color: var(--color-text); }
  .theme-toggle__btn:focus-visible { outline: 2px solid var(--color-blue); outline-offset: 2px; }
  .theme-toggle__btn[aria-pressed='true'] { color: var(--color-text); background: var(--raised-bg); box-shadow: var(--raised-shadow); }
</style>

<script>
  const media = matchMedia('(prefers-color-scheme: light)');
  const root = document.documentElement;
  const read = () => { try { return localStorage.getItem('theme') || 'system'; } catch { return 'system'; } };
  const apply = (pref: string) => {
    root.dataset.theme = pref === 'system' ? (media.matches ? 'light' : 'dark') : pref;
    document.querySelectorAll<HTMLButtonElement>('[data-theme-value]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeValue === pref)));
  };
  apply(read());
  document.querySelectorAll<HTMLButtonElement>('[data-theme-value]').forEach((b) => b.addEventListener('click', () => {
    const pref = b.dataset.themeValue!;
    try { localStorage.setItem('theme', pref); } catch {}
    apply(pref);
  }));
  media.addEventListener('change', () => { if (read() === 'system') apply('system'); });
</script>
