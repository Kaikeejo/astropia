---
import type { CollectionEntry } from 'astro:content';
import Pattern from '../ui/Pattern.astro';
import Icon from '../ui/Icon.astro';

interface Props { item: CollectionEntry<'featured'> }
const { name, badge, headline, description, file, pattern } = Astro.props.item.data;
---

<article class="featured-card">
  <div class="featured-card__content">
    <div class="featured-card__top">
      <div class="featured-card__name">
        <span class="h5 muted">{name}</span>
        <span class="badge accent blue">{badge}</span>
      </div>
      <ul class="featured-card__tech" aria-label="Built with">
        <li title="3D"><Icon name="box" size={20} /></li>
        <li title="Particles"><Icon name="sparkles" size={20} /></li>
        <li title="Shaders"><Icon name="layers" size={20} /></li>
      </ul>
    </div>
    <div class="featured-card__text">
      <h3 class="h3">{headline}</h3>
      <p class="paragraph muted">{description}</p>
    </div>
    <a class="featured-card__link h6 blue" href={`#${Astro.props.item.id}`}>Learn more<Icon name="chevron-right" size={20} /></a>
  </div>

  <div class="featured-card__preview">
    <div class="window-bar">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="tab paragraph muted"><Icon name="orbit" size={16} />{file}</span>
    </div>
    <div class="featured-card__canvas"><Pattern name={pattern} /></div>
  </div>
</article>

<style>
  .featured-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-40);
    padding: var(--space-48) 0 0 var(--space-48);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    overflow: hidden;
    background:
      radial-gradient(ellipse 45.5% 31% at 45% 55%, rgb(38 99 235 / 0.45), rgb(38 99 235 / 0.12) 60%, transparent),
      var(--color-surface);
    transition: border-color var(--dur) var(--ease);
  }
  .featured-card:hover { border-color: var(--color-border-strong); }
  .featured-card__content { display: flex; flex-direction: column; gap: var(--space-24); padding-right: var(--space-48); }
  .featured-card__top { display: flex; align-items: center; gap: var(--space-16); }
  .featured-card__name { flex: 1; display: flex; align-items: center; gap: var(--space-16); }
  .badge { padding: 4px var(--space-8); border-radius: var(--radius-full); background: var(--color-surface-2); }
  .featured-card__tech { display: flex; gap: var(--space-8); list-style: none; margin: 0; padding: 0; }
  .featured-card__tech li {
    display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%;
    background: var(--color-surface-2); border: 1px solid var(--color-border); color: var(--color-text-muted);
  }
  .featured-card__text { display: flex; flex-direction: column; gap: var(--space-16); min-height: 144px; }
  .featured-card__link { display: inline-flex; align-items: center; gap: 4px; align-self: flex-start; }
  .featured-card__link :global(svg) { transition: translate var(--dur) var(--ease); }
  .featured-card__link:hover :global(svg) { translate: 4px 0; }

  .featured-card__preview {
    margin-top: auto;
    border-top-left-radius: var(--radius-md);
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
    background: var(--color-surface-2);
    overflow: hidden;
    transition: translate 400ms var(--ease);
  }
  .featured-card:hover .featured-card__preview { translate: 0 -8px; }
  .window-bar { display: flex; align-items: center; gap: var(--space-16); padding: var(--space-8) var(--space-16); background: var(--color-surface); }
  .dots { display: flex; gap: var(--space-8); }
  .dots i { width: 12px; height: 12px; border-radius: 50%; background: #ff5f57; }
  .dots i:nth-child(2) { background: #febc2e; }
  .dots i:nth-child(3) { background: #28c840; }
  .tab { display: inline-flex; align-items: center; gap: var(--space-8); padding: var(--space-8) var(--space-16); border-radius: var(--radius-sm); background: var(--color-surface-2); }
  .featured-card__canvas { position: relative; height: 256px; }
</style>
