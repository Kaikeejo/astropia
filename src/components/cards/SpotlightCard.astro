---
import type { CollectionEntry } from 'astro:content';
import Pattern from '../ui/Pattern.astro';
import Button from '../ui/Button.astro';

interface Props { author: CollectionEntry<'spotlight'> }
const { name, initials, role, patterns } = Astro.props.author.data;
---

<article class="spotlight-card">
  <div class="spotlight-card__items">
    {patterns.map((p) => <a class="spotlight-card__item" href="#"><Pattern name={p} /></a>)}
  </div>
  <div class="spotlight-card__bar">
    <span class="spotlight-card__avatar h4">{initials}</span>
    <div class="spotlight-card__info">
      <h3 class="h3">{name}</h3>
      <p class="h5 muted">{role}</p>
    </div>
    <Button type="grey" size="large">Follow</Button>
  </div>
</article>

<style>
  .spotlight-card {
    width: 100%;
    max-width: none; /* full container width, like the other sections */
    margin: 0 auto;
    border-radius: var(--radius-lg);
    overflow: hidden;
    position: relative;
    isolation: isolate;
    background: var(--color-surface);
  }
  /* same animated pink/blue edge as the hero search bar */
  .spotlight-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    padding: 1px;
    background: conic-gradient(
      from var(--border-angle),
      rgb(217 40 117 / 0.35) 0deg,
      rgb(255 120 180 / 1) 40deg,
      rgb(217 40 117 / 0.5) 80deg,
      rgb(76 141 255 / 0.25) 130deg,
      rgb(76 141 255 / 0.35) 180deg,
      rgb(150 195 255 / 1) 220deg,
      rgb(76 141 255 / 0.5) 260deg,
      rgb(217 40 117 / 0.25) 310deg,
      rgb(217 40 117 / 0.35) 360deg
    );
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
    animation: border-spin 8s linear infinite;
    pointer-events: none;
  }
  @property --border-angle { syntax: '<angle>'; initial-value: 0deg; inherits: false; }
  @keyframes border-spin { to { --border-angle: 360deg; } }
  @media (prefers-reduced-motion: reduce) { .spotlight-card::before { animation: none; } }
  /* no gaps: single 1px dividers between the thumbnails */
  .spotlight-card__items { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--color-border); }
  .spotlight-card__item { position: relative; height: 280px; overflow: hidden; }
  .spotlight-card__item + .spotlight-card__item { border-left: 1px solid var(--color-border); }
  .spotlight-card__item :global(.pattern) { border: 0; border-radius: 0; }
  .spotlight-card__item:hover :global(.pattern__canvas) { scale: 1.08; }
  .spotlight-card__bar { display: flex; align-items: center; gap: var(--space-24); padding: var(--space-32) var(--space-40); }
  .spotlight-card__avatar {
    display: grid; place-items: center; width: 72px; height: 72px; border-radius: 50%; flex: none;
    background: var(--color-blue); color: var(--color-text);
  }
  .spotlight-card__info { flex: 1; }
  .spotlight-card__bar :global(.btn-raised) { box-shadow: var(--raised-edge); } /* Follow: no drop shadow */
</style>
