---
import type { CollectionEntry } from 'astro:content';
import Pattern from '../ui/Pattern.astro';
import Icon from '../ui/Icon.astro';

interface Props { hero: CollectionEntry<'heroes'> }
const { hero } = Astro.props;
const { title, author, category, isNew, pattern, likes, added } = hero.data;
---

<article class="hero-card" data-category={category} data-search={`${title} ${author} ${category}`.toLowerCase()}
  data-title={title} data-author={author} data-likes={likes} data-added={added}>
  <div class="hero-card__thumb">
    <Pattern name={pattern} blank /> {/* artwork hidden for now: remove `blank` to bring it back */}
    <div class="hero-card__scrim"></div>
    {isNew && <span class="tag blue hero-card__new">New</span>}
    <div class="hero-card__actions">
      <button type="button" class="icon-btn" aria-label={`Quick preview ${title}`} data-preview={hero.id} data-title={title} data-category={category}>
        <Icon name="eye" size={16} />
      </button>
      <button type="button" class="icon-btn" aria-label={`Copy ${title}`} data-copy={title}>
        <Icon name="copy" size={16} />
      </button>
    </div>
  </div>
  <div class="hero-card__body">
    <div class="hero-card__title-row">
      <h3 class="h6 hero-card__title">{title}</h3>
    </div>
    <p class="hero-card__meta paragraph muted">
      <span class="avatar" aria-hidden="true"></span>
      {author}<span aria-hidden="true">·</span>{category}
    </p>
  </div>
</article>

<style>
  .hero-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: var(--space-8);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .hero-card[hidden] { display: none; }
  .hero-card:hover { border-color: var(--color-border-strong); }

  .hero-card__thumb { position: relative; height: 176px; border-radius: 12px; overflow: hidden; }
  .hero-card:hover :global(.pattern__canvas) { scale: 1.06; }

  /* NEW tag sits on the thumbnail, top left */
  .hero-card__new { position: absolute; top: var(--space-16); left: var(--space-16); z-index: 1; }
  .hero-card__scrim {
    position: absolute;
    inset: 0;
    background: var(--scrim);
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }
  .hero-card__actions {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
  }
  /* small glass button: same smoky glass + animated gradient edge as the hero search bar */
  .icon-btn {
    position: relative;
    display: grid;
    place-items: center;
    padding: 14px;
    border: 0;
    border-radius: var(--radius-full);
    color: var(--color-text);
    cursor: pointer;
    isolation: isolate;
    background: var(--glass-bg);
    backdrop-filter: blur(10px) saturate(240%) brightness(1.15);
    -webkit-backdrop-filter: blur(10px) saturate(240%) brightness(1.15);
    box-shadow: var(--glass-shadow-sm);
  }
  .icon-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: conic-gradient(
      from var(--border-angle),
      rgb(217 40 117 / 0.35) 0deg,
      rgb(255 120 180 / 1) 40deg,
      rgb(217 40 117 / 0.5) 80deg,
      rgb(76 141 255 / 0.25) 130deg,
      rgb(76 141 255 / 0.35) 180deg,
      rgb(150 195 255 / 1) 220deg,
      rgb(76 141 255 / 0.5) 260deg,
      rgb(217 40 117 / 0.25) 310deg,
      rgb(217 40 117 / 0.35) 360deg
    );
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
    animation: border-spin 8s linear infinite;
    pointer-events: none;
  }
  .icon-btn :global(svg) { position: relative; }
  .icon-btn:hover { filter: brightness(1.25); }
  @property --border-angle { syntax: '<angle>'; initial-value: 0deg; inherits: false; }
  @keyframes border-spin { to { --border-angle: 360deg; } }
  @media (prefers-reduced-motion: reduce) { .icon-btn::before { animation: none; } }

  /* hover reveal: actions fade/slide in */
  .hero-card__actions > * {
    opacity: 0;
    translate: 0 8px;
    transition: opacity var(--dur) var(--ease), translate var(--dur) var(--ease), filter var(--dur) var(--ease);
  }
  .hero-card__actions > :nth-child(2) { transition-delay: 40ms; }
  .hero-card:hover .hero-card__scrim,
  .hero-card:focus-within .hero-card__scrim { opacity: 1; }
  .hero-card:hover .hero-card__actions > *, .hero-card:focus-within .hero-card__actions > * { opacity: 1; translate: 0 0; }


  .hero-card__body { display: flex; flex-direction: column; gap: var(--space-8); padding: var(--space-8); }
  .hero-card__title-row { display: flex; align-items: center; gap: var(--space-8); }
  .hero-card__title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hero-card__meta { display: flex; align-items: center; gap: var(--space-8); }
  .avatar { width: 24px; height: 24px; border-radius: 50%; background: var(--color-blue); flex: none; }
</style>
