---
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import Starfield from '../ui/Starfield.astro';
---

<dialog class="qp" aria-labelledby="qp-title">
  <div class="qp__modal">
    <header class="qp__header">
      <p class="qp__title paragraph muted">Quick preview <span aria-hidden="true">·</span> <span class="h6" id="qp-title" data-qp-title>Hero</span></p>
      <span class="qp__url paragraph muted"><Icon name="globe" size={16} /><span data-qp-url>astropia.dev/preview</span></span>
      <div class="qp__actions">
        <Button type="primary" size="small" data-qp-copy>Copy component</Button>
        <button type="button" class="qp__close" aria-label="Close preview" data-qp-close><Icon name="x" size={20} /></button>
      </div>
    </header>
    <div class="qp__body">
      <Starfield />
      <div class="qp__glow" aria-hidden="true"></div>
      <p class="accent muted" data-qp-eyebrow>Hero</p>
      <h2 class="h1">Your headline here</h2>
      <p class="h5 muted">This is how your own content sits on top of the animation.</p>
      <div class="qp__buttons">
        <Button type="primary">Get started</Button>
        <Button type="secondary">Learn more</Button>
      </div>
    </div>
  </div>
</dialog>

<style>
  .qp { padding: 0; border: 0; background: none; max-width: none; max-height: none; width: min(1312px, calc(100vw - 64px)); height: min(784px, calc(100vh - 64px)); color: var(--color-text); }
  .qp::backdrop { background: rgb(5 6 10 / 0.6); backdrop-filter: blur(8px); }
  .qp[open] .qp__modal { animation: qp-in 260ms var(--ease); }
  @keyframes qp-in { from { opacity: 0; scale: 0.97; translate: 0 12px; } }
  .qp__modal {
    display: flex; flex-direction: column; height: 100%;
    border-radius: var(--radius-md); overflow: hidden;
    background: var(--color-surface); border: 1px solid var(--color-border);
    box-shadow: 0 24px 64px rgb(0 0 0 / 0.6);
  }
  .qp__header { display: flex; align-items: center; gap: var(--space-16); padding: var(--space-16) var(--space-24); border-bottom: 1px solid var(--color-border); }
  .qp__title { flex: 1; display: flex; align-items: center; gap: var(--space-8); }
  .qp__title .h6 { color: var(--color-text); }
  .qp__url { display: inline-flex; align-items: center; gap: var(--space-8); padding: var(--space-8) var(--space-16); border-radius: var(--radius-full); background: var(--color-surface-2); }
  .qp__actions { flex: 1; display: flex; justify-content: flex-end; align-items: center; gap: var(--space-8); }
  .qp__close { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--color-surface-2); border: 1px solid var(--color-border); cursor: pointer; transition: background var(--dur) var(--ease); }
  .qp__close:hover { background: var(--color-border-strong); }
  .qp__body { position: relative; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-24); text-align: center; background: var(--color-bg); overflow: hidden; }
  .qp__body > :not(.starfield, .qp__glow) { position: relative; }
  .qp__glow { position: absolute; left: 50%; top: 50%; width: 1000px; height: 560px; translate: -50% -60%; border-radius: 50%; background: radial-gradient(closest-side, rgb(77 115 255 / 0.35), rgb(76 141 255 / 0.12) 50%, transparent); filter: blur(80px); }
  .qp__buttons { display: flex; gap: var(--space-16); }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.qp');
  if (dialog) {
    const set = (sel: string, text: string) => dialog.querySelector(sel)!.textContent = text;
    document.querySelectorAll<HTMLButtonElement>('[data-preview]').forEach((btn) => {
      btn.addEventListener('click', () => {
        set('[data-qp-title]', btn.dataset.title ?? 'Hero');
        set('[data-qp-url]', `astropia.dev/preview/${btn.dataset.preview}`);
        set('[data-qp-eyebrow]', `${btn.dataset.title} · ${btn.dataset.category}`);
        dialog.showModal();
      });
    });
    dialog.querySelector('[data-qp-close]')!.addEventListener('click', () => dialog.close());
    // click on the dimmed backdrop closes too
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  }
</script>
