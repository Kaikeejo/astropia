---
import { getCollection } from 'astro:content';
import SectionHeader from '../ui/SectionHeader.astro';
import FeaturedCard from '../cards/FeaturedCard.astro';
const items = (await getCollection('featured')).sort((a, b) => a.data.order - b.data.order);
---

<section class="section">
  <div class="container featured">
    <SectionHeader title="Featured this month" subtitle="Hand-picked heroes from the Astropia team." link={{ label: 'See all featured', href: '#' }} />
    <div class="featured__row">{items.map((item) => <FeaturedCard item={item} />)}</div>
  </div>
</section>

<style>
  .featured { display: flex; flex-direction: column; gap: var(--space-32); }
  .featured__row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-16); }
  @media (max-width: 960px) { .featured__row { grid-template-columns: 1fr; } }
</style>
