---
import Starfield from '../ui/Starfield.astro';
import Icon from '../ui/Icon.astro';
---

<section class="hero section" id="explore">
  <Starfield />
  <div class="hero__glow" aria-hidden="true"></div>
  <h1 class="h1">Astro Resources</h1>
  <p class="h5 muted hero__lead">Tweak 3D and particle hero sections live, then copy one component straight into your Astro project.</p>
  <div class="hero__search-wrap">
  <label class="hero__search">
    <Icon name="search" />
    <span class="sr-only">Search</span>
    <input class="paragraph" type="search" placeholder="Search heroes, effects, authors…" aria-label="Search heroes" data-hero-search />
    <kbd class="accent muted">⌘K</kbd>
  </label>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex; flex-direction: column; align-items: center; gap: var(--space-32);
    text-align: center;
    padding-top: 8rem;
    padding-bottom: var(--space-48);
  }
  .hero > :not(.starfield, .hero__glow) { position: relative; }
  /* starfield + glow sit behind all content and bleed into the next section */
  .hero :global(.starfield) {
    z-index: -1;
    top: 0;
    bottom: auto;
    height: 45rem;
    mask-image: linear-gradient(to bottom, #000 50%, transparent 100%);
  }
  .hero__glow {
    position: absolute; left: 50%; top: -120px; width: 900px; height: 480px; translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--brand-blue) 35%, transparent), color-mix(in srgb, var(--brand-blue) 12%, transparent) 50%, transparent);
    filter: blur(80px);
    opacity: var(--hero-glow-opacity);
    pointer-events: none;
    z-index: -1;
  }
  .hero__lead { max-width: 640px; margin-top: calc(var(--space-16) * -1); } /* 1rem from the H1 instead of 2rem */
  /* UI8-style dark glass search bar */
  .hero__search {
    position: relative;
    display: flex; align-items: center; gap: var(--space-16);
    width: 100%;
    padding: var(--space-16) var(--space-24);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    cursor: text;
    isolation: isolate;
    /* smoky tint + blur: anything moving behind shows through, softened */
    background: var(--glass-bg);
    backdrop-filter: blur(10px) saturate(240%) brightness(1.15);
    -webkit-backdrop-filter: blur(10px) saturate(240%) brightness(1.15);
    box-shadow: var(--glass-shadow); /* top highlight, inner depth, outer rim (no drop shadow) */
    transition: box-shadow var(--dur) var(--ease);
  }
  /* animated gradient edge: bright pink + blue highlights travel around the pill */
  @property --border-angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }
  .hero__search::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: conic-gradient(
      from var(--border-angle),
      var(--brand-ring)
    );
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
    animation: border-spin 8s linear infinite;
    pointer-events: none;
  }
  @keyframes border-spin { to { --border-angle: 360deg; } }
  @media (prefers-reduced-motion: reduce) {
    .hero__search::before { animation: none; }
  }

  .hero__search-wrap { position: relative; width: 100%; max-width: 640px; isolation: isolate; }
  .hero__search-wrap .hero__search { z-index: 1; }

  .hero__search > * { position: relative; }
  .hero__search input { flex: 1; min-width: 0; background: none; border: 0; outline: 0; color: var(--color-text); }
  .hero__search input::placeholder { color: var(--color-text-muted); }
  kbd { font-size: 0.6875rem; letter-spacing: 0; }
</style>
