---
import { getCollection } from 'astro:content';
import Chip from '../ui/Chip.astro';
import Icon from '../ui/Icon.astro';
import HeroCard from '../cards/HeroCard.astro';
const heroes = (await getCollection('heroes')).sort((a, b) => a.data.order - b.data.order);
// filter chips come from the heroes' categories, so a new category shows up automatically
const filters = ['All', ...new Set(heroes.map((h) => h.data.category))];
const sorts = [
  { value: 'random', label: 'Random' },
  { value: 'popular', label: 'Popular' },
  { value: 'newest', label: 'Newest' },
  { value: 'oldest', label: 'Oldest' },
  { value: 'az', label: 'A–Z' },
  { value: 'za', label: 'Z–A' },
  { value: 'author', label: 'Author' },
];
---

<section class="section fresh" id="heroes">
  <div class="container fresh__inner">
    <div class="fresh__filters filterbar">
      <div class="segmented" role="group" aria-label="Filter heroes">
        <span class="segmented__thumb" aria-hidden="true"></span>
        {filters.map((f, i) => <Chip value={f} active={i === 0}>{f}</Chip>)}
      </div>
      <span class="fresh__spacer"></span>
      <div class="sort">
        <button type="button" class="fresh__sort btn-raised paragraph" aria-haspopup="menu" aria-expanded="false" aria-controls="sort-menu" data-sort-toggle>
          Sort: <span data-sort-label>Random</span> <Icon name="chevron-down" size={16} />
        </button>
        <ul class="sort__menu" id="sort-menu" role="menu" aria-label="Sort heroes" hidden>
          {sorts.map((s, i) => (
            <li role="none">
              <button type="button" role="menuitemradio" class="sort__item paragraph" data-sort={s.value} aria-checked={i === 0 ? 'true' : 'false'}>{s.label}</button>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="fresh__grid">
      {heroes.map((hero) => <HeroCard hero={hero} />)}
    </div>
    <p class="fresh__empty paragraph muted" hidden>No heroes in this category yet.</p>
    <div class="fresh__footer" data-pager-bar>
      <nav class="pager" aria-label="Hero pages" data-pager>
        <button type="button" class="pager__btn pager__prev" data-page-prev aria-label="Previous page"><Icon name="chevron-right" size={16} /></button>
        <span class="pager__pages" data-page-list></span>
        <button type="button" class="pager__btn" data-page-next aria-label="Next page"><Icon name="chevron-right" size={16} /></button>
      </nav>
      <p class="fresh__status paragraph muted" data-pager-status aria-live="polite"></p>
    </div>
  </div>
</section>

<style>
  .fresh { padding-top: var(--space-48); }
  .fresh__inner { display: flex; flex-direction: column; gap: var(--space-32); }

  .fresh__spacer { flex: 1; }

  /* one dark pill holding filters (left) and sort (right), UI8 style */
  .filterbar {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-16);
    padding: 3px;
    border: 1px solid var(--color-border); /* same as the cards */
    border-radius: var(--radius-full);
    background: var(--color-well);
    box-shadow: var(--inset-shadow);
  }
  .segmented {
    position: relative;
    display: flex;
    gap: 2px;
    min-width: 0;
  }
  /* only scroll sideways on small screens (scrolling would clip the thumb on desktop) */
  @media (max-width: 800px) {
    .segmented { overflow-x: auto; scrollbar-width: none; }
  }
  /* the raised tab that slides to the active filter */
  .segmented__thumb {
    position: absolute;
    top: 0; bottom: 0; left: 0;
    width: var(--w, 0px);
    translate: var(--x, 0px) 0;
    border-radius: var(--radius-full);
    background: var(--raised-bg);
    box-shadow: var(--raised-shadow);
    transition: translate 380ms cubic-bezier(0.3, 1.25, 0.5, 1), width 380ms cubic-bezier(0.3, 1.25, 0.5, 1);
  }
  .segmented.no-anim .segmented__thumb { transition: none; }
  .fresh__sort { padding: var(--space-8) var(--space-16); }
  .fresh__sort :global(svg) { color: var(--color-text); transition: rotate var(--dur) var(--ease); }
  .fresh__sort[aria-expanded='true'] :global(svg) { rotate: 180deg; }
  /* sort dropdown: same raised grey language as the buttons */
  .sort { position: relative; }
  .sort__menu {
    position: absolute; right: 0; top: calc(100% + var(--space-8)); z-index: 10;
    min-width: 11rem;
    margin: 0; padding: 4px; list-style: none;
    display: flex; flex-direction: column; gap: 2px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .sort__menu[hidden] { display: none; }
  .sort__item {
    width: 100%; text-align: left;
    padding: var(--space-8) var(--space-16);
    border: 0; border-radius: var(--radius-sm);
    background: none; color: var(--color-text-muted);
    cursor: pointer; white-space: nowrap;
    transition: color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .sort__item:hover, .sort__item:focus-visible { color: var(--color-text); background: var(--color-surface-2); outline: none; }
  .sort__item[aria-checked='true'] { color: var(--color-text); background: var(--raised-bg); box-shadow: var(--raised-shadow); }
  .fresh__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-16); }
  /* page changes scroll back to the filter bar, clear of the sticky nav */
  .fresh__filters { scroll-margin-top: 96px; }
  /* pagination (left) + "Showing x to y of z heroes" (right) */
  .fresh__footer { display: flex; align-items: center; justify-content: space-between; gap: var(--space-16); flex-wrap: wrap; }
  .fresh__footer[hidden] { display: none; }
  .pager {
    display: inline-flex; align-items: center; gap: 2px; padding: 3px;
    border: 1px solid var(--color-border); border-radius: var(--radius-full);
    background: var(--color-well); box-shadow: var(--inset-shadow);
  }
  .pager[hidden] { display: none; }
  .pager__pages { display: inline-flex; gap: 2px; }
  .pager :global(.pager__btn) {
    display: grid; place-items: center; min-width: 36px; height: 36px; padding: 0 10px;
    border: 0; border-radius: var(--radius-full); background: none;
    color: var(--color-text-muted); font: inherit; font-size: 0.875rem; font-variant-numeric: tabular-nums;
    cursor: pointer; transition: color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .pager :global(.pager__btn:hover:not(:disabled)) { color: var(--color-text); }
  .pager :global(.pager__btn:focus-visible) { outline: 2px solid var(--color-blue); outline-offset: 2px; }
  .pager :global(.pager__btn[aria-current='page']) { color: var(--color-text); background: var(--raised-bg); box-shadow: var(--raised-shadow); }
  .pager :global(.pager__btn:disabled) { opacity: 0.35; cursor: default; }
  .pager__prev :global(svg) { rotate: 180deg; }
  .pager :global(.pager__gap) { display: grid; place-items: center; min-width: 24px; color: var(--color-text-muted); }
  @media (max-width: 1100px) { .fresh__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .fresh__grid { grid-template-columns: 1fr; } }
</style>

<script>
  // Filter chips + hero search: show only cards that match both.
  const section = document.querySelector<HTMLElement>('.fresh');
  if (section) {
    const chips = section.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = section.querySelectorAll<HTMLElement>('.hero-card'); // (not [data-category]: the preview buttons carry that too)
    const empty = section.querySelector<HTMLElement>('.fresh__empty')!;
    const bar = section.querySelector<HTMLElement>('.segmented')!;
    const moveThumb = (chip: HTMLElement) => {
      bar.style.setProperty('--x', `${chip.offsetLeft}px`);
      bar.style.setProperty('--w', `${chip.offsetWidth}px`);
    };
    const active = () => section.querySelector<HTMLElement>('[data-filter][aria-pressed="true"]')!;
    // place it instantly on load (and after fonts load / resize), then animate on clicks
    bar.classList.add('no-anim');
    moveThumb(active());
    document.fonts?.ready.then(() => moveThumb(active()));
    requestAnimationFrame(() => requestAnimationFrame(() => bar.classList.remove('no-anim')));
    addEventListener('resize', () => moveThumb(active()));

    // Pagination: 24 cards per page, over whatever the filter + search + sort currently give
    const PER_PAGE = 24;
    let page = 1;
    const grid = section.querySelector<HTMLElement>('.fresh__grid')!;
    const pagerBar = section.querySelector<HTMLElement>('[data-pager-bar]')!;
    const pager = section.querySelector<HTMLElement>('[data-pager]')!;
    const pageList = section.querySelector<HTMLElement>('[data-page-list]')!;
    const prev = section.querySelector<HTMLButtonElement>('[data-page-prev]')!;
    const next = section.querySelector<HTMLButtonElement>('[data-page-next]')!;
    const status = section.querySelector<HTMLElement>('[data-pager-status]')!;
    // page numbers with gaps: 1 … 4 5 6 … 10
    const pageNumbers = (n: number, cur: number): (number | '…')[] => {
      if (n <= 7) return Array.from({ length: n }, (_, i) => i + 1);
      const out: (number | '…')[] = [1];
      const from = Math.max(2, Math.min(cur - 1, n - 4)), to = Math.min(n - 1, Math.max(cur + 1, 5));
      if (from > 2) out.push('…');
      for (let i = from; i <= to; i++) out.push(i);
      if (to < n - 1) out.push('…');
      out.push(n);
      return out;
    };
    const paginate = () => {
      const matches = [...grid.children].filter((c): c is HTMLElement => (c as HTMLElement).dataset.match !== 'false' && c.classList.contains('hero-card'));
      const total = matches.length, pages = Math.max(1, Math.ceil(total / PER_PAGE));
      page = Math.min(Math.max(1, page), pages);
      const start = (page - 1) * PER_PAGE;
      cards.forEach((card) => { card.hidden = true; });
      matches.slice(start, start + PER_PAGE).forEach((card) => { card.hidden = false; });
      pagerBar.hidden = total === 0;
      pager.hidden = pages <= 1;
      status.textContent = `Showing ${start + 1} to ${Math.min(start + PER_PAGE, total)} of ${total} heroes`;
      prev.disabled = page === 1; next.disabled = page === pages;
      pageList.replaceChildren(...pageNumbers(pages, page).map((p) => {
        if (p === '…') { const gap = document.createElement('span'); gap.className = 'pager__gap'; gap.textContent = '…'; return gap; }
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'pager__btn'; b.textContent = String(p);
        b.setAttribute('aria-label', `Page ${p}`);
        if (p === page) b.setAttribute('aria-current', 'page');
        b.addEventListener('click', () => goTo(p));
        return b;
      }));
    };
    const goTo = (p: number) => {
      page = p; paginate();
      // bring the top of the grid back into view
      section.querySelector('.fresh__filters')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    prev.addEventListener('click', () => goTo(page - 1));
    next.addEventListener('click', () => goTo(page + 1));

    // Filtering = category chip AND the hero search text (title, author or category)
    let filter = 'All', query = '';
    const searchInput = document.querySelector<HTMLInputElement>('[data-hero-search]');
    const apply = () => {
      const words = query.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      cards.forEach((card) => {
        const inCategory = filter === 'All' || card.dataset.category === filter;
        const text = card.dataset.search ?? '';
        const match = inCategory && words.every((w) => text.includes(w));
        card.dataset.match = String(match);
        if (match) shown++;
      });
      page = 1;
      paginate();
      empty.textContent = query.trim()
        ? `No heroes match "${query.trim()}"${filter === 'All' ? '' : ` in ${filter}`}.`
        : 'No heroes in this category yet.';
      empty.hidden = shown > 0;
    };

    chips.forEach((chip) => chip.addEventListener('click', () => {
      filter = chip.dataset.filter ?? 'All';
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      moveThumb(chip);
      apply();
    }));

    // Sort dropdown: reorders the cards in the grid (works together with filters + search)
    const toggle = section.querySelector<HTMLButtonElement>('[data-sort-toggle]')!;
    const menu = section.querySelector<HTMLElement>('.sort__menu')!;
    const label = section.querySelector<HTMLElement>('[data-sort-label]')!;
    const items = [...menu.querySelectorAll<HTMLButtonElement>('[data-sort]')];
    const byText = (k: 'title' | 'author') => (a: HTMLElement, b: HTMLElement) => (a.dataset[k] ?? '').localeCompare(b.dataset[k] ?? '');
    const compare: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      popular: (a, b) => Number(b.dataset.likes) - Number(a.dataset.likes),
      newest: (a, b) => (b.dataset.added ?? '').localeCompare(a.dataset.added ?? ''),
      oldest: (a, b) => (a.dataset.added ?? '').localeCompare(b.dataset.added ?? ''),
      az: byText('title'),
      za: (a, b) => byText('title')(b, a),
      author: (a, b) => byText('author')(a, b) || byText('title')(a, b),
    };
    const openMenu = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      if (open) (items.find((i) => i.getAttribute('aria-checked') === 'true') ?? items[0]).focus();
    };
    // Random: a fresh shuffle on every visit (and every time Random is picked again)
    const shuffle = <T,>(list: T[]) => { for (let i = list.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [list[i], list[j]] = [list[j], list[i]]; } return list; };
    const sortBy = (value: string) => {
      (value === 'random' ? shuffle([...cards]) : [...cards].sort(compare[value])).forEach((card) => grid.appendChild(card));
      page = 1; paginate();
      items.forEach((i) => i.setAttribute('aria-checked', String(i.dataset.sort === value)));
      label.textContent = items.find((i) => i.dataset.sort === value)?.textContent ?? '';
    };
    toggle.addEventListener('click', () => openMenu(menu.hidden === true));
    items.forEach((item) => item.addEventListener('click', () => { sortBy(item.dataset.sort!); openMenu(false); toggle.focus(); }));
    menu.addEventListener('keydown', (e) => {
      const i = items.indexOf(document.activeElement as HTMLButtonElement);
      if (e.key === 'ArrowDown') { e.preventDefault(); items[(i + 1) % items.length].focus(); }
      if (e.key === 'ArrowUp') { e.preventDefault(); items[(i - 1 + items.length) % items.length].focus(); }
      if (e.key === 'Escape') { openMenu(false); toggle.focus(); }
    });
    document.addEventListener('click', (e) => { if (!menu.hidden && !(e.target as Element).closest('.sort')) openMenu(false); });
    sortBy('random');

    if (searchInput) {
      searchInput.addEventListener('input', () => { query = searchInput.value; apply(); });
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') { e.preventDefault(); section.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
        if (e.key === 'Escape') { searchInput.value = ''; query = ''; apply(); }
      });
      // the nav search button and Cmd/Ctrl+K jump to the hero search
      const focusSearch = () => { scrollTo({ top: 0, behavior: 'smooth' }); searchInput.focus({ preventScroll: true }); };
      document.querySelector('.navbar__search')?.addEventListener('click', focusSearch);
      addEventListener('keydown', (e) => { if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); focusSearch(); } });
    }
  }

</script>
