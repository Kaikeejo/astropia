---
import '@fontsource-variable/sora';
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props { title: string; description?: string }
const { title, description = 'Animated, copy-paste hero sections for Astro.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      // apply the saved theme (or the OS setting) before first paint, so there is no flash
      (function () {
        var pref = 'system';
        try { pref = localStorage.getItem('theme') || 'system'; } catch (e) {}
        var light = pref === 'light' || (pref === 'system' && matchMedia('(prefers-color-scheme: light)').matches);
        document.documentElement.dataset.theme = light ? 'light' : 'dark';
        // spot colours picked with the colour pickers (filter bar)
        try {
          var brand = JSON.parse(localStorage.getItem('brand') || '{}');
          if (brand.blue) document.documentElement.style.setProperty('--brand-blue', brand.blue);
          if (brand.pink) document.documentElement.style.setProperty('--brand-pink', brand.pink);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
    <div class="toast paragraph" role="status" aria-live="polite" hidden></div>
  </body>
</html>

<style is:global>
  .toast {
    position: fixed; left: 50%; bottom: var(--space-32); translate: -50% 0; z-index: 50;
    padding: var(--space-8) var(--space-16); border-radius: var(--radius-full);
    background: var(--color-surface-2); border: 1px solid var(--color-border-strong);
    box-shadow: var(--shadow-md);
  }
</style>

<script>
  // Shared bits of interactivity: copy buttons + a small toast message.
  const toast = document.querySelector<HTMLElement>('.toast')!;
  let t: number | undefined;
  const say = (msg: string) => {
    toast.textContent = msg; toast.hidden = false;
    clearTimeout(t); t = window.setTimeout(() => (toast.hidden = true), 1800);
  };

  const copy = async (text: string) => {
    try { await navigator.clipboard.writeText(text); say('Copied to clipboard'); } catch { say('Copy failed'); }
  };
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const name = (btn.dataset.copy ?? 'Hero').replace(/\s+/g, '');
      copy(`<${name}>\n  <h1>Your headline</h1>\n</${name}>`);
    }));
  document.querySelector('[data-qp-copy]')?.addEventListener('click', () => {
    const name = (document.querySelector('[data-qp-title]')?.textContent ?? 'Hero').replace(/\s+/g, '');
    copy(`<${name}>\n  <h1>Your headline</h1>\n</${name}>`);
  });
</script>
