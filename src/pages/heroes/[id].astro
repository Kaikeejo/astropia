---
// One page per hero that has a live engine (every card in Pixels, Space, ...).
import { getCollection } from 'astro:content';
import Playground from '../../heroes/Playground.astro';

export async function getStaticPaths() {
  const heroes = await getCollection('heroes', (h) => !!h.data.engine);
  return heroes.map((hero) => ({ params: { id: hero.id }, props: { hero } }));
}
const { hero } = Astro.props;
const { title, engine, settings } = hero.data;
---

<Playground title={title} engine={engine!} settings={settings} />
